<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="panel rol-<%= usuario.rol %>">
  <%- include('partials/navbar') %>

  <main>
    <h1><%= rolLabel %></h1>
    <p class="sub"><%= subtitulo %></p>

    <!-- Indicadores generales -->
    <div class="cards">
      <% Object.entries(data.resumen).forEach(function ([clave, valor]) { %>
        <div class="card"><h3><%= clave %></h3><p><%= valor %></p></div>
      <% }); %>
    </div>

    <!-- ================= CIUDADANO ================= -->
    <% if (usuario.rol === 'ciudadano') { %>

      <section>
        <h2>Reportar incidente o congestión vehicular</h2>
        <form method="post" action="/incidentes" class="fila">
          <input name="tipo" placeholder="Tipo de incidente (ej: congestión vehicular)" required>
          <input name="ubicacion" placeholder="Ubicación (zona o dirección)" required>
          <textarea name="descripcion" placeholder="Descripción concisa y detallada" required></textarea>
          <button class="btn">Reportar incidente</button>
        </form>
      </section>

      <section>
        <h2>Mis incidentes</h2>
        <table>
          <thead><tr><th>Fecha</th><th>Tipo</th><th>Ubicación</th><th>Estado</th></tr></thead>
          <tbody>
            <% data.misIncidentes.forEach(function (i) { %>
              <tr>
                <td><%= i.fecha %></td><td><%= i.tipo %></td><td><%= i.ubicacion %></td>
                <td><span class="badge"><%= i.estado %></span></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </section>

      <section>
        <h2>Participación ciudadana</h2>
        <form method="post" action="/participaciones" class="fila">
          <select name="zona_id" required>
            <option value="">Selecciona una zona</option>
            <% data.zonas.forEach(function (z) { %><option value="<%= z.id %>"><%= z.nombre %></option><% }); %>
          </select>
          <select name="categoria" required>
            <option value="">Categoría</option>
            <option>Movilidad</option><option>Energía</option><option>Agua</option>
            <option>Residuos</option><option>Seguridad</option><option>Salud</option><option>Educación</option>
          </select>
          <textarea name="comentario" placeholder="Tu propuesta o reporte" required></textarea>
          <button class="btn">Enviar participación</button>
        </form>

        <h3>Mis participaciones</h3>
        <table>
          <thead><tr><th>Fecha</th><th>Zona</th><th>Categoría</th><th>Comentario</th></tr></thead>
          <tbody>
            <% data.misParticipaciones.forEach(function (p) { %>
              <tr><td><%= p.fecha %></td><td><%= p.zona %></td><td><%= p.categoria %></td><td><%= p.comentario %></td></tr>
            <% }); %>
          </tbody>
        </table>
      </section>

      <section>
        <h2>Alertas de mi ciudad</h2>
        <%- include('partials/tabla-alertas', { alertas: data.alertas, acciones: false }) %>
      </section>
    <% } %>

    <!-- ================= AUTORIDAD ================= -->
    <% if (usuario.rol === 'autoridad') { %>

      <section>
        <h2>Alertas por nivel</h2>
        <div class="cards">
          <% data.porNivel.forEach(function (n) { %>
            <div class="card"><h3><%= n.nivel %></h3><p><%= n.total %></p></div>
          <% }); %>
        </div>
      </section>

      <section>
        <h2>Crear alerta</h2>
        <form method="post" action="/alertas" class="fila">
          <select name="zona_id" required>
            <option value="">Zona</option>
            <% data.zonas.forEach(function (z) { %><option value="<%= z.id %>"><%= z.nombre %></option><% }); %>
          </select>
          <select name="servicio_id" required>
            <option value="">Servicio</option>
            <% data.servicios.forEach(function (s) { %><option value="<%= s.id %>"><%= s.nombre %></option><% }); %>
          </select>
          <select name="nivel"><option>bajo</option><option selected>medio</option><option>alto</option><option>critico</option></select>
          <textarea name="descripcion" placeholder="Descripción de la alerta" required></textarea>
          <button class="btn">Crear alerta</button>
        </form>

        <h3>Alertas</h3>
        <form method="get" action="/" class="mini">
          <select name="ciudad_id" onchange="this.form.submit()">
            <option value="0">Todas las ciudades</option>
            <% data.ciudades.forEach(function (c) { %>
              <option value="<%= c.id %>" <%= data.ciudadFiltro === c.id ? 'selected' : '' %>><%= c.nombre %></option>
            <% }); %>
          </select>
        </form>
        <%- include('partials/tabla-alertas', { alertas: data.alertas, acciones: true }) %>
      </section>

      <section>
        <h2>Gestión de incidentes</h2>
        <table>
          <thead><tr><th>Fecha</th><th>Tipo</th><th>Ubicación</th><th>Descripción</th><th>Reportado por</th><th>Estado</th><th>Acciones</th></tr></thead>
          <tbody>
            <% data.incidentes.forEach(function (i) { %>
              <tr>
                <td><%= i.fecha %></td><td><%= i.tipo %></td><td><%= i.ubicacion %></td>
                <td><%= i.descripcion %></td><td><%= i.reportado_por %></td>
                <td><span class="badge"><%= i.estado %></span></td>
                <td>
                  <form method="post" action="/incidentes/<%= i.id %>/estado" class="mini">
                    <select name="estado">
                      <option value="reportado" <%= i.estado === 'reportado' ? 'selected' : '' %>>reportado</option>
                      <option value="en_revision" <%= i.estado === 'en_revision' ? 'selected' : '' %>>en_revision</option>
                      <option value="atendido" <%= i.estado === 'atendido' ? 'selected' : '' %>>atendido</option>
                      <option value="cerrado" <%= i.estado === 'cerrado' ? 'selected' : '' %>>cerrado</option>
                    </select>
                    <button class="btn btn-sm">Actualizar</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </section>

      <section>
        <h2>Servicios urbanos · registrar consumo</h2>
        <p class="sub">Si el consumo registrado supera el límite permitido, el sistema genera la alerta automáticamente.</p>
        <table>
          <thead><tr><th>Servicio</th><th>Consumo actual</th><th>Límite</th><th>Unidad</th><th>Estado</th><th>Registrar consumo</th></tr></thead>
          <tbody>
            <% data.servicios.forEach(function (s) { %>
              <tr>
                <td><%= s.nombre %></td>
                <td><%= s.consumo_actual %></td>
                <td><%= s.limite_permitido %></td>
                <td><%= s.unidad %></td>
                <td>
                  <% if (Number(s.consumo_actual) > Number(s.limite_permitido)) { %>
                    <span class="badge nivel-critico">Excedido</span>
                  <% } else { %>
                    <span class="badge nivel-bajo">Normal</span>
                  <% } %>
                </td>
                <td>
                  <form method="post" action="/servicios/<%= s.id %>/consumo" class="mini">
                    <input type="number" step="0.01" name="consumo_actual" placeholder="Nuevo consumo" required>
                    <button class="btn btn-sm">Registrar</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </section>

      <section>
        <h2>Decisiones justificadas (transparencia)</h2>
        <form method="post" action="/decisiones" class="fila">
          <input name="titulo" placeholder="Decisión tomada" required>
          <select name="estado"><option value="aprobada">aprobada</option><option value="descartada">descartada</option></select>
          <textarea name="justificacion" placeholder="¿Por qué se toma esta decisión? (obligatorio)" required></textarea>
          <button class="btn">Registrar decisión</button>
        </form>
        <table>
          <thead><tr><th>Fecha</th><th>Decisión</th><th>Justificación</th><th>Estado</th><th>Autor</th></tr></thead>
          <tbody>
            <% data.decisiones.forEach(function (d) { %>
              <tr>
                <td><%= d.fecha %></td><td><%= d.titulo %></td><td><%= d.justificacion %></td>
                <td><span class="badge"><%= d.estado %></span></td><td><%= d.autor %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </section>

      <section>
        <h2>Reportes</h2>
        <form method="post" action="/reportes" class="fila">
          <input name="titulo" placeholder="Título del reporte" required>
          <select name="tipo"><option>Informe</option><option>Indicadores</option><option>Ambiental</option><option>Institucional</option></select>
          <textarea name="descripcion" placeholder="Contenido del reporte"></textarea>
          <button class="btn">Generar reporte</button>
        </form>
        <table>
          <thead><tr><th>Fecha</th><th>Título</th><th>Tipo</th><th>Autor</th><th>Descripción</th></tr></thead>
          <tbody>
            <% data.reportes.forEach(function (r) { %>
              <tr><td><%= r.fecha %></td><td><%= r.titulo %></td><td><%= r.tipo %></td><td><%= r.autor %></td><td><%= r.descripcion %></td></tr>
            <% }); %>
          </tbody>
        </table>
      </section>
    <% } %>

    <!-- ================= EMPRESA ================= -->
    <% if (usuario.rol === 'empresa') { %>

      <section>
        <h2>Alertas de mi servicio (validar resultados)</h2>
        <%- include('partials/tabla-alertas', { alertas: data.alertas, acciones: true }) %>
      </section>

      <section>
        <h2>Sensores urbanos</h2>
        <table>
          <thead><tr><th>Ciudad</th><th>Zona</th><th>Tipo</th><th>Estado</th><th>Acciones</th></tr></thead>
          <tbody>
            <% data.sensores.forEach(function (s) { %>
              <tr>
                <td><%= s.ciudad %></td><td><%= s.zona %></td><td><%= s.tipo %></td>
                <td><span class="badge"><%= s.estado %></span></td>
                <td>
                  <form method="post" action="/sensores/<%= s.id %>/estado" class="mini">
                    <select name="estado">
                      <option value="activo" <%= s.estado === 'activo' ? 'selected' : '' %>>activo</option>
                      <option value="inactivo" <%= s.estado === 'inactivo' ? 'selected' : '' %>>inactivo</option>
                      <option value="mantenimiento" <%= s.estado === 'mantenimiento' ? 'selected' : '' %>>mantenimiento</option>
                    </select>
                    <button class="btn btn-sm">Actualizar</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </section>
    <% } %>

    <!-- ================= ORGANIZACIÓN ================= -->
    <% if (usuario.rol === 'organizacion') { %>

      <section>
        <h2>Sensores por estado</h2>
        <div class="cards">
          <% data.sensoresPorEstado.forEach(function (s) { %>
            <div class="card"><h3><%= s.estado %></h3><p><%= s.total %></p></div>
          <% }); %>
        </div>
      </section>

      <section>
        <h2>Alertas por nivel</h2>
        <div class="cards">
          <% data.alertasPorNivel.forEach(function (n) { %>
            <div class="card"><h3><%= n.nivel %></h3><p><%= n.total %></p></div>
          <% }); %>
        </div>
      </section>

      <section>
        <h2>Participación por categoría</h2>
        <div class="cards">
          <% data.participacionesPorCategoria.forEach(function (p) { %>
            <div class="card"><h3><%= p.categoria %></h3><p><%= p.total %></p></div>
          <% }); %>
        </div>
      </section>

      <section>
        <h2>Verificación de cumplimiento normativo</h2>
        <table>
          <thead><tr><th>Código</th><th>Norma</th><th>Organismo</th><th>Estado</th><th>Observación</th><th>Verificado</th></tr></thead>
          <tbody>
            <% data.normativas.forEach(function (n) { %>
              <tr>
                <td><%= n.codigo %></td><td><%= n.nombre %></td><td><%= n.organismo %></td>
                <td><span class="badge"><%= n.estado || 'sin_datos' %></span></td>
                <td><%= n.observacion || '—' %></td><td><%= n.fecha || '—' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </section>

      <section>
        <h2>Reportes de las autoridades</h2>
        <table>
          <thead><tr><th>Fecha</th><th>Título</th><th>Tipo</th><th>Autor</th></tr></thead>
          <tbody>
            <% data.reportes.forEach(function (r) { %>
              <tr><td><%= r.fecha %></td><td><%= r.titulo %></td><td><%= r.tipo %></td><td><%= r.autor %></td></tr>
            <% }); %>
          </tbody>
        </table>
      </section>

      <section>
        <h2>Alertas recientes</h2>
        <%- include('partials/tabla-alertas', { alertas: data.alertas, acciones: false }) %>
      </section>
    <% } %>

  </main>
</body>
</html> 
