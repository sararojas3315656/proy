<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/css/styles.css?v=41">
</head>
<body class="auth rol-<%= rol || 'default' %>">
  <%- include('partials/mascota', { rol: rol || '' }) %>
  <div class="auth-box">
    <div class="auth-head">
      <h1>SGCI</h1>
      <p>Sistema de Gestión de Ciudades Inteligentes</p>
    </div>

    <% if (ok) { %><div class="ok">Cuenta creada correctamente. Ya puedes iniciar sesión.</div><% } %>
    <% if (error) { %><div class="error"><%= error %></div><% } %>

    <p class="rol-aviso" id="rolAviso">Elige tu perfil para continuar</p>

    <div class="rol-picker">
      <button type="button" class="rol-card" data-rol="ciudadano" title="Usuario">
        <span class="rol-emoji"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 20c0-3.4 3-5.5 7.5-5.5s7.5 2.1 7.5 5.5"/></svg></span>
        <span class="rol-nombre">Usuario</span>
      </button>
      <button type="button" class="rol-card" data-rol="empresa" title="Empresa">
        <span class="rol-emoji"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5.5" y="3.5" width="13" height="17" rx="1.5"/><path d="M9.5 3.5V2.6a.9.9 0 0 1 .9-.9h3.2a.9.9 0 0 1 .9.9v.9M9 8h1.8M13.2 8H15M9 11.5h1.8M13.2 11.5H15M9 15h1.8M13.2 15H15M10.5 20.5v-2.2M13.5 20.5v-2.2"/></svg></span>
        <span class="rol-nombre">Empresa</span>
      </button>
      <button type="button" class="rol-card" data-rol="autoridad" title="Seguridad">
        <span class="rol-emoji"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7.5 3v5.2c0 4.9-3.3 8.2-7.5 9.8-4.2-1.6-7.5-4.9-7.5-9.8V6l7.5-3z"/><path d="M9.2 12l1.9 1.9 3.7-3.7"/></svg></span>
        <span class="rol-nombre">Seguridad</span>
      </button>
      <button type="button" class="rol-card" data-rol="organizacion" title="Organización">
        <span class="rol-emoji"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3.5 12h17M12 3c2.6 2.5 3.9 5.6 3.9 9s-1.3 6.5-3.9 9c-2.6-2.5-3.9-5.6-3.9-9s1.3-6.5 3.9-9z"/></svg></span>
        <span class="rol-nombre">Organización</span>
      </button>
    </div>

    <form method="post" action="/login" class="login-form oculto" id="loginForm">
      <input type="hidden" name="rol" id="rolInput" value="<%= rol %>">
      <label for="correo">Correo electrónico</label>
      <input type="email" id="correo" name="correo" value="<%= correo %>" required>

      <label for="contraseña">Contraseña</label>
      <input type="password" id="contraseña" name="contraseña" required>

      <button type="submit" class="btn btn-entrar">Ingresar</button>
    </form>

    <p class="link">¿No tienes cuenta? <a href="/registro">Regístrate</a></p>
  </div>

  <script>
    (function () {
      var form = document.getElementById('loginForm');
      var rolInput = document.getElementById('rolInput');
      var aviso = document.getElementById('rolAviso');
      var correoCampo = document.getElementById('correo');
      var passCampo = document.getElementById('contraseña');
      var cards = Array.prototype.slice.call(document.querySelectorAll('.rol-card'));

      var guardados = {};
      var rolActual = null;

      function guardarActual() {
        if (rolActual) {
          guardados[rolActual] = {
            correo: correoCampo ? correoCampo.value : '',
            pass: passCampo ? passCampo.value : ''
          };
        }
      }

      function aplicar(rol) {
        guardarActual();
        rolActual = rol;
        document.body.className = 'auth rol-' + (rol || 'default');
        cards.forEach(function (card) {
          card.classList.toggle('activo', card.getAttribute('data-rol') === rol);
        });

        if (rol) {
          rolInput.value = rol;
          var datos = guardados[rol] || { correo: '', pass: '' };
          if (correoCampo && correoCampo.value !== datos.correo) correoCampo.value = datos.correo;
          if (passCampo && passCampo.value !== datos.pass) passCampo.value = datos.pass;
          form.classList.remove('oculto');
          aviso.classList.add('oculto');
          form.classList.remove('mostrar');
          void form.offsetWidth;
          form.classList.add('mostrar');
          if (correoCampo) correoCampo.focus();
        } else {
          rolInput.value = '';
          form.classList.add('oculto');
          aviso.classList.remove('oculto');
        }
      }

      cards.forEach(function (card) {
        card.addEventListener('click', function () {
          aplicar(card.getAttribute('data-rol'));
        });
      });

      if (rolInput.value) {
        if (correoCampo && correoCampo.value) {
          guardados[rolInput.value] = { correo: correoCampo.value, pass: '' };
        }
        aplicar(rolInput.value);
      }
    })();
  </script>
  <script src="/js/mascota.js?v=7"></script>
</body>
</html>
